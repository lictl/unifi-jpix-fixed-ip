# IPIP Configuration
# Copy this file to /data/scripts/ipip/config.env and fill in values.
USERNAME="" # Username, for example: kotei1234567890
PASSWORD="" # Password, for example: a1a1a1a1
IPV4_CIDR="" # static IPv4 in CIDR notation, for example: 1.1.1.1/32
IPV6_IID="" # IPv6 Interface Identifier (lower 64 bits), for example: ::003b:80cf:2900:0000
IPV6_REMOTE="2404:9200:225:100::65" # tunnel remote endpoint (IPv6 or hostname)
